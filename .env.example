# Set unique, strong passwords before starting the production containers.
POSTGRES_DB=shopping
POSTGRES_SUPERUSER_PASSWORD=replace-with-a-long-random-password
DB_APP_USER=shopping_app
DB_APP_PASSWORD=replace-with-another-long-random-password
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-random-password-of-at-least-12-characters
COOKIE_SECURE=false
TRUST_PROXY=0
APP_BIND_ADDRESS=0.0.0.0

# Used by `npm run dev` on the host. Docker Compose builds its own URL.
DATABASE_URL=postgresql://shopping_app:replace-with-another-long-random-password@localhost:5432/shopping
PORT=3000
